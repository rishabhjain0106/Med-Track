# ========================================================
# MedTrack (CareOS) - Environment Configuration
# ========================================================

# Application Core
APP_NAME="MedTrack (CareOS)"
APP_VERSION=1.0.0
DEBUG=False

# Primary Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/medtrack

# Cache & Rate Limiting (Redis)
# Format: redis://<host>:<port>/<db_index>
REDIS_URL=redis://localhost:6379/0

# JWT Auth & Security
SECRET_KEY=careos-ultra-secure-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business Rules & Concurrency Control
# Unconfirmed reservations auto-expire and return to inventory after this duration
RESERVATION_EXPIRY_MINUTES=30
# Low stock threshold to prioritize emergency triage
EMERGENCY_RESERVATION_BUFFER_THRESHOLD=2

# Pluggable Data Sources
# Options: 'local' (PostgreSQL) | 'external' (e-RaktKosh / external blood bank stub)
BLOOD_DATA_SOURCE=local
MEDICINE_DATA_SOURCE=local
BEDS_DATA_SOURCE=local
EXTERNAL_BLOOD_BANK_API_URL=https://api.externalbloodbank.example.org/v1/availability

# Redis Cache TTLs (in seconds)
CACHE_DEFAULT_TTL_SECONDS=45
NEAREST_SEARCH_CACHE_TTL_SECONDS=30

# Public API Rate Limiting (per client IP)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Background Worker Sweep Interval (in seconds)
EXPIRY_CHECK_INTERVAL_SECONDS=30

# Frontend Environment Variable
VITE_API_URL=http://localhost:8000
